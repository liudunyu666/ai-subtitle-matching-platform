# ASR provider: set OPENAI_API_KEY or DASHSCOPE_API_KEY
# OpenAI Whisper API Key (optional)
OPENAI_API_KEY=
# Alibaba DashScope API Key (optional, for paraformer ASR)
DASHSCOPE_API_KEY=
# Public base URL of the backend (required for DashScope ASR, e.g. https://your-app.onrender.com)
PUBLIC_BASE_URL=
# Database URL (default: sqlite:///smp.db)
DATABASE_URL=sqlite:///smp.db
# App secret key
SECRET_KEY=your-secret-key
